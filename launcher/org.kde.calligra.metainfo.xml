  <name>MimOffice</name>
  <summary>All-in-one office suite</summary>
  <description>
    <p>
      MimOffice is an office suite bringing together a word processor (Words), a
      spreadsheet application (Sheets), a presentation tool (Stage), and a vector
      graphics editor (Karbon) under one launcher. MimOffice is a rebrand of KDE
      Calligra maintained by XI14, made in the spirit of MimOS.
    </p>
  </description>
  <url type="homepage">https://mimoslinux.org</url>
  <url type="bugtracker">https://github.com/MarcZX100/MimOffice/issues</url>
  <content_rating type="oars-1.1"/>
  <screenshots>
    <screenshot type="default">
      <image>https://cdn.kde.org/screenshots/calligra/words-desktop-mode.png</image>
      <caption>MimOffice Words</caption>
    </screenshot>
    <screenshot>
      <image>https://cdn.kde.org/screenshots/calligrasheets/calligrasheets.png</image>
      <caption>MimOffice Sheets</caption>
    </screenshot>
    <screenshot>
      <image>https://cdn.kde.org/screenshots/calligra/calligrastage.png</image>
      <caption>MimOffice Stage</caption>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#7C5CFC</color>
    <color type="primary" scheme_preference="dark">#1A0F1E</color>
  </branding>
  <project_group>MimOffice</project_group>
  <provides>
